---
import "../../styles/global.css";

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sequence to Sequence Learning with Neural Networks · AI Blazers</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href={base}>
        <span class="brand-mark">AI</span>
        <span>AI Blazers</span>
        <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
      </a>

      <nav class="nav">
        <a href={base}>Home</a>
      </nav>
    </header>

    <main class="paper-page">
      <article class="paper-article">
        <p class="eyebrow">NLP · Seq2Seq · 2014</p>

        <h1 class="paper-title">
          Sequence to Sequence Learning with Neural Networks
        </h1>

        <p class="paper-subtitle">
          This is the reading note for the Seq2Seq paper.
        </p>

        <h2>One-sentence summary</h2>
        <p>
          This paper shows that an LSTM encoder-decoder can map one sequence to another sequence.
        </p>

        <h2>Why this paper matters</h2>
        <p>
          Add your detailed reading notes here.
        </p>
      </article>
    </main>
  </body>
</html>