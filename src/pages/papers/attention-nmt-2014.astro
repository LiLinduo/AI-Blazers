const algorithmSteps = [
  {
    step: "1",
    name: "Encode the source",
    formula: "x_1, ..., x_Tx → h_1, ..., h_Tx",
    explanation: "A bidirectional RNN creates one contextual annotation for each source position.",
  },
  {
    step: "2",
    name: "Score each source position",
    formula: "e_ij = a(s_{i−1}, h_j)",
    explanation: "For target step i, compare the previous decoder state with every source annotation.",
  },
  {
    step: "3",
    name: "Normalize scores",
    formula: "α_ij = softmax_j(e_ij)",
    explanation: "Convert raw alignment scores into a probability distribution over source positions.",
  },
  {
    step: "4",
    name: "Build context",
    formula: "c_i = Σ_j α_ij h_j",
    explanation: "Compute a weighted average of source annotations for the current target word.",
  },
  {
    step: "5",
    name: "Generate next word",
    formula: "p(y_i | y_<i, x) = g(y_{i−1}, s_i, c_i)",
