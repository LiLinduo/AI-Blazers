---
import PaperLayout from "../../components/paper/PaperLayout.astro";

const annotations = {
  nmt: {
    type: "Field",
    title: "Neural Machine Translation",
    body:
      "Neural machine translation means using a neural network to model translation directly, usually as p(target sentence | source sentence). Instead of relying on phrase tables and many separately tuned components, the model learns representations and generation rules from parallel data.",
    why:
      "This paper is an early turning point where neural translation becomes more than a helper feature for statistical systems. The model itself performs translation end-to-end.",
    related: ["Seq2Seq", "Encoder-Decoder", "Attention", "Parallel Corpus"],
  },
  encoder: {
    type: "Architecture Component",
    title: "Encoder",
    body:
      "The encoder reads the source sentence and turns it into internal vectors. In this paper, the proposed model uses a bidirectional RNN encoder, producing one annotation vector h_j for each source position.",
    why:
      "The shift from one final encoder vector to a sequence of encoder annotations is what makes attention possible.",
    related: ["Bidirectional RNN", "Annotation", "Source Sentence"],
  },
  decoder: {
    type: "Architecture Component",
    title: "Decoder",
    body:
      "The decoder generates the target sentence one token at a time. At step i, it uses the previous target token, its hidden state, and a context vector c_i computed from attention over the source sentence.",
    why:
      "The decoder is where alignment becomes dynamic: each generated word can look at a different part of the source sentence.",
    related: ["Autoregressive Generation", "Context Vector", "Beam Search"],
  },
  moses: {
    type: "Baseline System",
    title: "Moses",
    body:
      "Moses is a strong phrase-based statistical machine translation baseline. It uses phrase tables, word alignments, reordering features, and a target-side language model rather than a fixed neural vocabulary.",
    why:
      "It is a tough comparison because it handles rare and unknown words better than early NMT. While RNNsearch maps out-of-vocabulary words to [UNK], Moses can often preserve names, numbers, and rare phrases through copying or phrase-table entries.",
    related: ["Phrase Table", "Language Model", "UNK", "BLEU"],
  },
  rnnencdec: {
    type: "Baseline Architecture",
    title: "RNN Encoder-Decoder",
    body:
      "The standard RNN encoder-decoder compresses the whole source sentence into a single fixed-length context vector c. The decoder then generates every target token from that same vector.",
    why:
      "This is the exact bottleneck that Bahdanau attention addresses: one fixed vector must carry all source information, even for long sentences.",
    related: ["Fixed-Vector Bottleneck", "RNN"],
  },
  fixedVector: {
    type: "Limitation",
    title: "Fixed-Vector Bottleneck",
    body:
      "A fixed-vector bottleneck occurs when a variable-length source sentence is compressed into a single vector of fixed dimensionality. Longer sentences must squeeze more information through the same narrow channel.",
    why:
      "The paper's central claim is that this bottleneck hurts translation quality, especially on long sentences.",
    related: ["Context Vector", "Information Bottleneck", "Long Sentences"],
  },
  attention: {
    type: "Mechanism",
    title: "Bahdanau Attention",
    body:
      "Bahdanau attention computes a relevance score between the current decoder state and every source annotation, normalizes those scores with softmax, and uses the resulting weights to form a step-specific context vector.",
    why:
      "This lets the model softly align and translate at the same time. It is one of the key ancestors of the attention mechanisms used in Transformers.",
    related: ["Soft Alignment", "Additive Attention", "Transformer"],
  },
  softAlignment: {
    type: "Interpretation",
    title: "Soft Alignment",
    body:
      "Soft alignment means a target token is not forced to align to exactly one source token. Instead, it receives a probability distribution over all source positions.",
    why:
      "This makes the model differentiable and flexible. A French article such as l' can attend to both the English word the and the following noun.",
    related: ["Word Alignment", "Attention Weights", "Differentiability"],
  },
  annotation: {
    type: "Representation",
    title: "Annotation h_j",
    body:
      "An annotation h_j is the encoder's contextual representation of source position j. Because it comes from a bidirectional RNN, it summarizes both left and right context around that source word.",
    why:
      "The decoder does not attend to raw words. It attends to contextual source representations.",
    related: ["Bidirectional RNN", "Hidden State", "Contextual Representation"],
  },
  additive: {
    type: "Scoring Function",
    title: "Additive Attention Score",
    body:
      "The alignment score is computed as v_a^T tanh(W_a s_{i-1} + U_a h_j). This is called additive attention because transformed decoder and encoder states are added before scoring.",
    why:
      "Later Transformer attention usually uses dot products. This paper's scoring function is the classic additive form.",
    related: ["Alignment Model", "Query-Key Matching", "Dot-Product Attention"],
  },
  birnn: {
    type: "Sequence Model",
    title: "Bidirectional RNN",
    body:
      "A bidirectional RNN reads the source sentence in both directions. The forward state summarizes preceding words, and the backward state summarizes following words.",
    why:
      "This gives each source annotation access to the whole sentence, not only the prefix before that word.",
    related: ["Forward RNN", "Backward RNN"],
  },
  bleu: {
    type: "Metric",
    title: "BLEU Score",
    body:
      "BLEU is an automatic machine translation metric based on n-gram overlap between a generated translation and reference translations.",
    why:
      "The paper uses BLEU to compare RNNsearch, the RNN encoder-decoder baseline, and Moses.",
    related: ["Machine Translation Evaluation", "n-gram Overlap"],
  },
  unk: {
    type: "Token",
    title: "UNK Token",
    body:
      "UNK is a special token used for words outside the model vocabulary. This paper keeps only the 30,000 most frequent words in each language, so rare words become UNK.",
    why:
      "UNK handling is a major limitation of the paper. RNNsearch looks much stronger when evaluated only on sentences without unknown words.",
    related: ["Rare Words", "Vocabulary", "Subword Tokenization"],
  },
  transformer: {
    type: "Historical Link",
    title: "Path to the Transformer",
    body:
      "Transformer attention is not identical to Bahdanau attention, but it inherits the idea of dynamically retrieving relevant information from a set of representations.",
    why:
      "Bahdanau attention is best viewed as a bridge: RNNs still model sequence order, while attention breaks the single-vector bottleneck.",
    related: ["Self-Attention", "Cross-Attention", "Positional Encoding"],
  },
  contextVector: {
    type: "Core Variable",
    title: "Context Vector c_i",
    body:
      "A context vector is the source-side information passed to the decoder. In the old encoder-decoder model, there is one fixed context vector c. In Bahdanau attention, each target step i gets its own context vector c_i.",
    why:
      "This is the central mathematical shift of the paper: translation no longer depends on one compressed sentence vector, but on a dynamically computed vector assembled from attention weights.",
    related: ["Fixed-Vector Bottleneck", "Attention Weights", "Source Annotations"],
  },
};

const sections = [
  ["overview", "Overview"],
  ["story", "Story"],
  ["problem", "Problem"],
  ["architecture", "Architecture"],
  ["math", "Derivation"],
  ["algorithm", "Algorithm"],
  ["complexity", "Complexity"],
  ["experiments", "Experiments"],
  ["results", "Results"],
  ["impact", "Impact"],
  ["takeaways", "Takeaways"],
];

