---
import katex from "katex";

interface Props {
  formula: string;
  displayMode?: boolean;
}

const {
  formula,
  displayMode = true,
} = Astro.props;

const html = katex.renderToString(formula, {
  displayMode,
  throwOnError: false,
  trust: false,
});
---

<div class="math-formula" set:html={html} />