---
type SectionItem = [id: string, label: string];

const { sections = [] } = Astro.props as {
  sections?: SectionItem[];
};
---

<aside class="left-rail">
  <div class="rail-card">
    <p class="rail-title">Paper Map</p>
    <nav class="toc">
      {sections.map(([id, label]) => (
        <a href={`#${id}`}>{label}</a>
      ))}
    </nav>
  </div>
</aside>